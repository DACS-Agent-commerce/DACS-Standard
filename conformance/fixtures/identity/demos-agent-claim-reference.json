{
  "kind": "DemosAgentClaimReferenceCases",
  "specRefs": [
    "§6.3.1",
    "§B.1"
  ],
  "cases": [
    {
      "id": "lowercase-canonical-form",
      "input": "did:demos:agent:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "expected": {
        "classification": "demos-agent-did",
        "accepted": true,
        "canonical": "did:demos:agent:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      }
    },
    {
      "id": "mixed-case-did-scheme-read",
      "input": "DID:demos:agent:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "expected": {
        "classification": "demos-agent-did",
        "accepted": true,
        "canonical": "did:demos:agent:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      }
    },
    {
      "id": "uppercase-key-noncanonical",
      "input": "did:demos:agent:0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF",
      "expected": {
        "classification": "invalid-demos-agent-did",
        "accepted": false,
        "canonical": null
      }
    },
    {
      "id": "demos-address-notation-is-unknown",
      "input": "demos:0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "expected": {
        "classification": "unknown-scheme",
        "accepted": false,
        "canonical": null,
        "aliasesDemosAgentDid": false
      }
    }
  ]
}
