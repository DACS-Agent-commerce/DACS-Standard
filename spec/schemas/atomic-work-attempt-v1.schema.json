{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dacs.dev/schemas/atomic-work-attempt-v1.schema.json",
  "title": "AtomicWorkAttemptV1",
  "type": "object",
  "required": [
    "attemptVersion",
    "workId",
    "attemptId",
    "nativeTransactionRef",
    "canonicalWorkBytes",
    "authorizations"
  ],
  "properties": {
    "attemptVersion": { "const": "1" },
    "workId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attemptId": { "type": "string", "minLength": 1 },
    "nativeTransactionRef": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "canonicalWorkBytes": {
      "description": "The exact RFC 8785 JCS JSON text whose UTF-8 encoding is canonicalWorkBytes in CORE §5.2.5.",
      "type": "string",
      "minLength": 2
    },
    "authorizations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "atomic-work-authorization-v1.schema.json" }
    },
    "nonce": { "type": "string", "minLength": 1 },
    "fee": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  },
  "additionalProperties": true
}
